<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:keepScreenOn="true">

    <!-- Stats Display Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/statsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/endTaskButton">

        <LinearLayout
            android:id="@+id/statsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="88dp"
            android:paddingTop="24dp"
            android:paddingEnd="164dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/alignmentStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Searching for body..."
                android:textAlignment="center"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FF5252"
                android:background="#33FF5252"
                android:padding="12dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:id="@+id/liveStatsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start moving to see stats"
                android:textColor="@android:color/white"
                android:textSize="24sp"
                android:lineSpacingExtra="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Camera "Picture-in-Picture" Frame -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cameraCard"
        android:layout_width="140dp"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="8dp"
        app:strokeColor="@android:color/white"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.camera.view.PreviewView
                android:id="@+id/viewFinder"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.example.exercisetracker.OverlayView
                android:id="@+id/overlayView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Set progress, only shown when a goal was set on Home -->
    <LinearLayout
        android:id="@+id/goalPanel"
        android:layout_width="140dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cameraCard"
        app:layout_constraintStart_toStartOf="@id/cameraCard"
        app:layout_constraintEnd_toEndOf="@id/cameraCard">

        <FrameLayout
            android:layout_width="110dp"
            android:layout_height="110dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/goalRing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:indicatorSize="110dp"
                app:trackThickness="8dp"
                app:indicatorColor="#BB86FC"
                app:trackColor="#33FFFFFF" />

            <TextView
                android:id="@+id/goalRingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="0/15"
                android:textColor="@android:color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <TextView
            android:id="@+id/goalSetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Set 1 of 3"
            android:textColor="@android:color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Sidebar Controls -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/backButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/filterButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_manage"
            app:tint="@android:color/white"
            android:contentDescription="Change exercise" />

        <ImageButton
            android:id="@+id/soundButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_lock_silent_mode_off"
            app:tint="@android:color/white"
            android:contentDescription="Toggle Sound" />

        <ImageButton
            android:id="@+id/pauseButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_media_pause"
            app:tint="@android:color/white"
            android:contentDescription="Pause workout" />

        <ImageButton
            android:id="@+id/rotateButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_rotate"
            app:tint="@android:color/white"
            android:contentDescription="Switch to landscape" />
    </LinearLayout>

    <Button
        android:id="@+id/endTaskButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="End Workout"
        android:layout_margin="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
